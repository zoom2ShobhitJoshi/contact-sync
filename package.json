{
  "name": "contact-sync",
  "productName": "Contact Sync",
  "version": "1.0.0",
  "description": "Sync photos, videos, documents, and audio from a WhatsApp contact to local folders",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "build": {
    "appId": "com.contactsync.app",
    "productName": "Contact Sync",
    "directories": {
      "buildResources": "build/icons"
    },
    "linux": {
      "icon": "build/icons"
    },
    "win": {
      "icon": "build/icons/icon.ico"
    },
    "mac": {
      "icon": "build/icons/icon.png"
    }
  },
  "scripts": {
    "dev": "vite --port 3847 --host 127.0.0.1",
    "dev:electron": "npm run build:electron && concurrently -k \"vite --port 3847 --host 127.0.0.1\" \"npm run electron:wait\"",
    "electron:wait": "wait-on http://127.0.0.1:3847 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:3847 electron .",
    "build": "tsc -p tsconfig.node.json && vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --port 3847 --host 127.0.0.1",
    "start": "electron ."
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.18",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8",
    "wait-on": "^8.0.3"
  }
}
