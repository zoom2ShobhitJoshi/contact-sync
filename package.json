{
  "name": "contact-sync",
  "productName": "Contact Sync",
  "version": "1.0.2",
  "description": "Sync photos, videos, documents, and audio from a WhatsApp contact to local folders",
  "author": "Contact Sync",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoom2ShobhitJoshi/contact-sync.git"
  },
  "bugs": {
    "url": "https://github.com/zoom2ShobhitJoshi/contact-sync/issues"
  },
  "homepage": "https://github.com/zoom2ShobhitJoshi/contact-sync#readme",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --port 3847 --host 127.0.0.1\" \"npm run electron:wait\"",
    "dev:electron": "npm run dev",
    "electron:wait": "wait-on http://127.0.0.1:3847 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:3847 electron .",
    "build": "npm run build:electron && vite build",
    "build:electron": "tsc -p tsconfig.node.json",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron ."
  },
  "build": {
    "appId": "com.contactsync.app",
    "productName": "Contact Sync",
    "copyright": "Copyright © Contact Sync",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icons/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "zoom2ShobhitJoshi",
        "repo": "contact-sync"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icons/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "ContactSync-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "ContactSync-${version}-${arch}.${ext}",
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Contact Sync",
      "artifactName": "ContactSync-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ContactSync-Portable-${version}.${ext}"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Utility",
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.18",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8",
    "wait-on": "^8.0.3"
  }
}
